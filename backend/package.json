{
  "name": "reachinbox-scheduler-backend",
  "version": "1.0.0",
  "description": "Backend API and worker service for ReachInbox Email Scheduler",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/tests/api.test.ts && tsx src/tests/scheduler.test.ts && tsx src/tests/rateLimiter.test.ts && tsx src/tests/authAndSlack.test.ts && tsx src/tests/elasticsearchAndBullBoard.test.ts",
    "test:api": "tsx src/tests/api.test.ts",
    "test:scheduler": "tsx src/tests/scheduler.test.ts",
    "test:ratelimit": "tsx src/tests/rateLimiter.test.ts",
    "test:auth": "tsx src/tests/authAndSlack.test.ts",
    "test:es": "tsx src/tests/elasticsearchAndBullBoard.test.ts",
    "test:audit": "tsx src/tests/integrationAudit.test.ts",
    "test:load": "tsx src/tests/loadTest.ts",
    "test:csv": "tsx src/tests/csvParser.test.ts",
    "send:test": "tsx src/scripts/sendTestEmail.ts",
    "reindex:emails": "tsx src/scripts/reindexElasticsearch.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@bull-board/api": "^6.8.0",
    "@bull-board/express": "^6.8.0",
    "@elastic/elasticsearch": "^8.17.0",
    "@prisma/client": "^6.4.1",
    "bullmq": "^5.41.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.4.1",
    "supertest": "^7.3.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
