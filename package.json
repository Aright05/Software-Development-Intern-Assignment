{
  "name": "reachinbox-scheduler-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ReachInbox Full-stack Email Job Scheduler",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:worker": "npm --prefix backend run worker",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm --prefix backend run test",
    "test:audit": "npm --prefix backend run test:audit",
    "test:load": "npm --prefix backend run test:load",
    "test": "npm run test:backend && npm run test:audit && npm run test:load",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend"
  },
  "keywords": [
    "reachinbox",
    "email-scheduler",
    "bullmq",
    "redis",
    "postgresql",
    "elasticsearch",
    "react",
    "vite",
    "typescript"
  ],
  "author": "",
  "license": "ISC"
}
